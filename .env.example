PRIVATE_KEY=0x...
PYTH_ADDRESS=0x...             # Pyth oracle address for the configured network
RPC_URL=https://your-rpc-url
DEPLOY_MOCK_USDC=true
# Used by InitializeDeployment when DEPLOY_MOCK_USDC=true (USDC has 6 decimals).
INITIAL_MOCK_USDC_MINT_AMOUNT=1000000000000
CHAIN_ID=8453                  # Must match RPC (143 Monad; 4663 Robinhood; 46630 Robinhood testnet)
NETWORK_NAME="Base Mainnet"    # Quote display labels containing spaces

# Contract Addresses (set after deployment)
USDC_ADDRESS=
PPUSDC_ADDRESS=              # For main PerpDex
PERPDEX_ADDRESS=
OCUSDC_ADDRESS=              # For OneClickPerpDex
ONECLICK_PERPDEX_ADDRESS=
OPUSDC_ADDRESS=              # For OptionsAMM
OPTIONS_AMM_ADDRESS=
PMUSDC_ADDRESS=              # Created by PredictionMarketAMM
PREDICTION_MARKET_AMM_ADDRESS=

# Prediction trading fee in basis points (default 30 = 0.3%, maximum 500 = 5%).
# Fixed at deployment; seed BTC/ETH/SOL separately with the prediction seed target.
PREDICTION_FEE_BPS=30

# Backend address to authorize for OneClickPerpDex (required for initialization).
BACKEND_ADDRESS=

# Required for Etherscan API V2 networks; not needed for Monad or Robinhood verification.
NATIVE_STAKING_ADDRESS=
ETHERSCAN_API_KEY=
# Optional Monad Sourcify endpoint override. Leave blank to use the official endpoint.
MONAD_SOURCIFY_URL=
# Optional Robinhood mainnet verification through Blockscout's PRO API.
# Without this key, Robinhood mainnet and testnet verify on Sourcify.
BLOCKSCOUT_API_KEY=
