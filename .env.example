PRIVATE_KEY=0x...
PYTH_ADDRESS=0x...             # Pyth oracle address for the configured network
RPC_URL=https://your-rpc-url
DEPLOY_MOCK_USDC=true
# Used by InitializeDeployment when DEPLOY_MOCK_USDC=true (USDC has 6 decimals).
INITIAL_MOCK_USDC_MINT_AMOUNT=1000000000000
CHAIN_ID=8453                  # Must match the RPC network (143 for Monad mainnet)
NETWORK_NAME=Base Mainnet      # Optional display label (e.g. Monad Mainnet)

# Contract Addresses (set after deployment)
USDC_ADDRESS=
PPUSDC_ADDRESS=              # For main PerpDex
PERPDEX_ADDRESS=
OCUSDC_ADDRESS=              # For OneClickPerpDex
ONECLICK_PERPDEX_ADDRESS=

# Backend Address (for OneClickPerpDex)
BACKEND_ADDRESS=

# Required for Etherscan API V2 networks; not required for Monad Sourcify verification.
NATIVE_STAKING_ADDRESS=
ETHERSCAN_API_KEY=
# Optional Monad Sourcify endpoint override. Leave blank to use the official endpoint.
MONAD_SOURCIFY_URL=
