PRIVATE_KEY=0x...
PYTH_ADDRESS=0x...             # Pyth oracle address for the configured network
RPC_URL=https://your-rpc-url
DEPLOY_MOCK_USDC=true
# Used by InitializeDeployment when DEPLOY_MOCK_USDC=true (USDC has 6 decimals).
INITIAL_MOCK_USDC_MINT_AMOUNT=40000000000000
CHAIN_ID=8453                  # Must match RPC (143 Monad; 4663 Robinhood; 46630 Robinhood testnet)
NETWORK_NAME="Base Mainnet"    # Quote display labels containing spaces

# Contract Addresses (set after deployment)
USDC_ADDRESS=
PPUSDC_ADDRESS=              # For main PerpDex
PERPDEX_ADDRESS=
OCUSDC_ADDRESS=              # For OneClickPerpDex
ONECLICK_PERPDEX_ADDRESS=
OPUSDC_ADDRESS=              # For OptionAMM
OPTION_AMM_ADDRESS=
PMUSDC_ADDRESS=              # Created by PredictionMarketAMM
PREDICTION_MARKET_AMM_ADDRESS=
TRADING_ACCOUNT7702_ADDRESS=  # Shared EIP-7702 delegation implementation

# Independent PerpDexAtlas pull-oracle deployment (uses existing USDC_ADDRESS).
ATLAS_SIGNER=
ATLAS_MAX_PRICE_AGE=5        # Seconds, allowed range 1-5; future timestamps are rejected
ATLAS_PPUSDC_ADDRESS=       # Fresh LP token for the Atlas vault
PERPDEX_ATLAS_ADDRESS=

# Independent Atlas option and prediction vaults (new LP tokens per deployment).
ATLAS_OPUSDC_ADDRESS=
OPTION_AMM_ATLAS_ADDRESS=
ATLAS_PMUSDC_ADDRESS=
PREDICTION_MARKET_AMM_ATLAS_ADDRESS=
# Private Atlas feed IDs from the user's My Feeds screenshot.
# Missing/blank overrides use these defaults for all 15 markets.
# IDs must be nonzero, unique bytes4 values (0x followed by eight hex digits).
ATLAS_BTC_FEED_ID=0x000004a6 # 1190: BTC/USDT
ATLAS_ETH_FEED_ID=0x000004a7 # 1191: ETH/USD
ATLAS_SOL_FEED_ID=0x000004a9 # 1193: SOL/USD
ATLAS_BNB_FEED_ID=0x000004aa # 1194: BNB/USD
ATLAS_HYPE_FEED_ID=0x000004ab # 1195: HYPE/USD
ATLAS_DOGE_FEED_ID=0x000004ac # 1196: DOGE/USD
ATLAS_XRP_FEED_ID=0x000004ad # 1197: XRP/USD
ATLAS_ZEC_FEED_ID=0x000004ae # 1198: ZEC/USD
ATLAS_AAPL_FEED_ID=0x000004af # 1199: AAPL/USD
ATLAS_MSFT_FEED_ID=0x000004b0 # 1200: MSFT/USD
ATLAS_AMZN_FEED_ID=0x000004b2 # 1202: AMZN/USD
ATLAS_GOOGL_FEED_ID=0x000004b1 # 1201: GOOGL/USD
ATLAS_META_FEED_ID=0x000004b4 # 1204: META/USD
ATLAS_NVDA_FEED_ID=0x000004b3 # 1203: NVDA/USD
ATLAS_TSLA_FEED_ID=0x000004b5 # 1205: TSLA/USD
# Prediction requires five-second freshness for trades, opening and resolution.
# Workers create/open rounds at any time; resolve after expiry using a fresh quote.
# Options retain historical boundary settlement and five-second spot freshness.

# Prediction vault edge in basis points (default 300 = 3%, maximum 500 = 5%).
# Fixed at deployment; seed all 15 markets with the Atlas prediction seed target.
PREDICTION_FEE_BPS=300

# Backend authorized for OneClickPerpDex and configured OptionAMM during initialization.
BACKEND_ADDRESS=

# Required for Etherscan API V2 networks; not needed for Monad or Robinhood verification.
NATIVE_STAKING_ADDRESS=
ETHERSCAN_API_KEY=
# Optional Monad Sourcify endpoint override. Leave blank to use the official endpoint.
MONAD_SOURCIFY_URL=
# Optional Robinhood mainnet verification through Blockscout's PRO API.
# Without this key, Robinhood mainnet and testnet verify on Sourcify.
BLOCKSCOUT_API_KEY=
